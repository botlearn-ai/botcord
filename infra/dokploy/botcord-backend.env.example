# Current shared-Preview-Supabase mode. Never commit real values.
# Set createEnvFile=true; omit optional keys instead of assigning empty strings.
BOTCORD_NETWORK=botcord-production
BOTCORD_DATABASE_NETWORK=botcord-databases
BOTCORD_BACKEND_IMAGE=

# Hub and frontend must use the same existing Supabase application database.
DATABASE_URL=postgresql+asyncpg://postgres:replace-me@db.your-project.supabase.co:5432/postgres
DATABASE_SCHEMA=public
SUPABASE_URL=
# Required for the currently verified JWKS validation path.
SUPABASE_JWT_JWKS_URL=
# The application supports HS256 for other deployments, but this Dokploy
# manifest requires the JWKS URL above. Do not leave it empty or substitute an
# HS256 secret in the current deployment.
# SUPABASE_JWT_SECRET=
# Required by current Hub Auth/Storage integration. Backend only; never place it
# in frontend build arguments or browser-visible variables.
SUPABASE_SERVICE_ROLE_KEY=
# Required by the current Supabase Storage mode.
SUPABASE_STORAGE_BUCKET=botcord-files
FILE_STORAGE_BACKEND=supabase

# This additional Hub must not own shared-schema DDL or periodic maintenance.
BOTCORD_SCHEMA_AUTO_CREATE=false
BOTCORD_BACKGROUND_TASKS_ENABLED=false

BOTCORD_REDIS_URL=redis://:REPLACE@botcord-redis-native-ogq8mr:6379/0
JWT_SECRET=
INTERNAL_API_SECRET=
BOTCORD_HUB_CONTROL_PRIVATE_KEY=
CLOUD_GATEWAY_INGRESS_SECRET=
BIND_PROOF_SECRET=
ENVIRONMENT_TAG=preview
ALLOW_PRIVATE_ENDPOINTS=false
BETA_GATE_ENABLED=false
CLOUD_AGENT_FEATURE_ENABLED=false
BOTLEARN_INTEGRATION_ENABLED=false
EXPO_PUSH_ENABLED=false

HUB_PUBLIC_BASE_URL=https://api.test.botcord.chat
FRONTEND_BASE_URL=https://www.test.botcord.chat
BOTLEARN_ALLOWED_ORIGINS=https://www.test.botcord.chat
AUTH_ALLOWED_ORIGINS=https://www.test.botcord.chat

# Payments, email, OAuth and paid runtimes remain opt-in and require separate QA.
# Consult backend/.env.example and hub/config.py; keep their secrets in Dokploy only.
