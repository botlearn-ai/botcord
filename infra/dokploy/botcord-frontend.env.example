# Runtime-only frontend server values for the current shared Preview Supabase mode.
# Build with NEXT_PUBLIC_APP_URL=https://www.test.botcord.chat and
# NEXT_PUBLIC_HUB_BASE_URL=https://api.test.botcord.chat.
BOTCORD_NETWORK=botcord-production
BOTCORD_FRONTEND_IMAGE=
SUPABASE_INTERNAL_URL=
# Same existing Supabase application database used by Hub; not botcord-postgres.
SUPABASE_DB_URL=
SUPABASE_DB_POOL_MAX=5
