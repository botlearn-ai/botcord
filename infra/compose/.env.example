# local.sh creates infra/compose/.env.local with private random values.
# This file documents the supported overrides; do not put real secrets here.
POSTGRES_PASSWORD=replace-with-a-random-value
REDIS_PASSWORD=replace-with-a-random-value
JWT_SECRET=replace-with-a-random-value
INTERNAL_API_SECRET=replace-with-a-random-value
CLOUD_GATEWAY_INGRESS_SECRET=replace-with-a-random-value
BOTCORD_HUB_CONTROL_PRIVATE_KEY=replace-with-a-base64-encoded-32-byte-ed25519-seed

# Paid/external integrations are disabled by default for the local stack.
CLOUD_AGENT_FEATURE_ENABLED=false
BOTLEARN_INTEGRATION_ENABLED=false
EXPO_PUSH_ENABLED=false

# Frontend: public values are embedded into the image. Use only the authorized existing project.
NEXT_PUBLIC_APP_URL=http://localhost:18080
NEXT_PUBLIC_HUB_BASE_URL=http://localhost:18000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Reachable by containers, may differ from browser URL. Preserve public auth cookie key.
SUPABASE_INTERNAL_URL=
BIND_PROOF_SECRET=

# When reusing an authorized existing Supabase, Hub and frontend MUST use the same DB.
# Keep both disabled on additional instances; do not run migrations/maintenance twice.
DATABASE_URL=
DATABASE_SCHEMA=public
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_JWT_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=botcord-files
FILE_STORAGE_BACKEND=supabase
BOTCORD_SCHEMA_AUTO_CREATE=false
BOTCORD_BACKGROUND_TASKS_ENABLED=false
